# Public origin of THIS site, and of the separate NexEagle corporate site it links out to.
# NEXT_PUBLIC_-prefixed: read client-side (share links, JSON-LD) and inlined at BUILD time, so
# they must be correct before `next build` -- Docker build-args in deploy.yml, not `docker run -e`.
# No trailing slash. Defaults (src/lib/site.ts) are the production origins.
#   Dev : NEXT_PUBLIC_SITE_URL=https://doctordekho-dev.nexeagle.com
#         NEXT_PUBLIC_BUSINESS_URL=https://nexeagle-dev.nexeagle.com
#   Prod: NEXT_PUBLIC_SITE_URL=https://doctordekho.nexeagle.com
#         NEXT_PUBLIC_BUSINESS_URL=https://nexeagle.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BUSINESS_URL=https://nexeagle.com

# ── EasyHMS public API (patient booking portal) ──────────────────────────────
# Root of the EasyHMS API (NO trailing slash, NO /api prefix — paths are off root). This is the
# only required var — the public API works with zero further configuration.
EASYHMS_API_BASE_URL=
# Optional — the public API doesn't require a key, so this can stay blank. Only set it if this
# deployment's traffic should be identified/revocable separately from anonymous callers, via
# easyHMSAPI's tools/IssuePublicApiKey console tool (see easyHMSAPI/docs/OPS-ISSUE-PUBLIC-API-KEY.md).
# Keep this server-side only — do NOT prefix with NEXT_PUBLIC. For production,
# move it out of this committed file into .env.local or a real secret store.
EASYHMS_API_KEY=
# Header the API expects the key in. Adjust to match the backend (e.g. X-Api-Key).
EASYHMS_API_KEY_HEADER=X-Api-Key
# Optional — lets easyHMSAPI's public rate limiters (booking, patient WhatsApp-OTP login) see each
# real visitor's IP instead of this app's own container IP. Every call to the API happens
# server-to-server (see src/lib/api/server.ts), so without this, easyHMSAPI's per-IP limits
# accidentally become a single shared budget across every visitor to the whole site. Must match
# Internal:ProxyForwardingSecret in easyHMSAPI's own config exactly — leave both blank to keep the
# previous (site-wide-budget) behavior; nothing breaks either way. Keep server-side only.
EASYHMS_TRUSTED_PROXY_SECRET=

# ── Maps (doctor detail page location preview + directions) ──────────────────
# Mapbox public token (pk.*) — powers the static clinic-location map on each doctor's page
# (DoctorLocationMap.tsx). Must be NEXT_PUBLIC_-prefixed (read client-side, baked in at build
# time). Leave blank to omit the map — the "Get Directions" button/link (Google Maps deep link)
# keeps working either way since it doesn't depend on this. Restrict the token to this site's
# domain(s) in the Mapbox dashboard before deploying.
NEXT_PUBLIC_MAPBOX_TOKEN=

# ── AI-assisted doctor search (app/api/search/parse) ─────────────────────────
# Optional — powers the "type/speak anything about symptoms" search fallback (see
# DoctorDirectory.tsx). Only called when the plain keyword search comes up empty, to
# interpret free text like "my chest hurts" into a specialty + location. Leave blank to
# disable — the search just stays literal-keyword-only, same as before this existed.
# Keep server-side only — do NOT prefix with NEXT_PUBLIC.
GROQ_API_KEY=
# Optional — override the Groq model (must support JSON mode). Default: llama-3.3-70b-versatile.
# GROQ_MODEL=
