{
  "expo": {
    "name": "Doctor Dekho",
    "slug": "doctordekho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nexeagle.doctordekho",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0F766E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nexeagle.doctordekho",
      "versionCode": 1,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-image",
      "expo-localization",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F766E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Doctor Dekho uses your location once to show doctors in your city."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of a prescription or report to keep it in your health records.",
          "photosPermission": "Choose a prescription or report photo to keep in your health records.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0F766E"
        }
      ],
      "expo-document-picker"
    ],
    "scheme": "doctordekho",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    }
  }
}
